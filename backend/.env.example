# Copy to .env and adjust as needed.

# Where uploaded files, the Chroma vector DB, and the SQLite metadata DB live.
STORAGE_DIR=storage

# Embedding model (sentence-transformers).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval.
TOP_K=5

# LLM provider — chosen later. One of: stub | anthropic | openai | ollama
LLM_PROVIDER=stub
# LLM_API_KEY=
# LLM_MODEL=
