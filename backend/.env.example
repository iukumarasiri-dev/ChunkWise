# Copy to .env and adjust as needed.

# Where uploaded files, the Chroma vector DB, and the SQLite metadata DB live.
STORAGE_DIR=storage

# Embedding model (sentence-transformers).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval.
TOP_K=5

# Answer generation. One of: stub | ollama
#   stub   - no model; echoes the top retrieved passage (default, zero setup)
#   ollama - a model via Ollama, either local or Ollama Cloud
LLM_PROVIDER=stub

# Which model to use. Blank -> llama3.1:8b.
#   local:  a tag you have pulled (`ollama pull llama3.1:8b`)
#   cloud:  a cloud model name from ollama.com/search (e.g. gpt-oss:120b)
LLM_MODEL=

# Local server:  http://localhost:11434   (no key needed)
# Ollama Cloud:  https://ollama.com       (OLLAMA_API_KEY required)
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
